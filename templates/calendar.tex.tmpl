% Weekday bar
\noindent
\begin{tikzpicture}[x={\textwidth/7},y=1cm]
\foreach \dayname [count=\ci from 0] in {Sunday,Monday,Tuesday,Wednesday,Thursday,Friday,Saturday} {
  \fill[weekdaybg] (\ci,0) rectangle (\ci+1,0.55);
  \node[anchor=center,white,font=\small\bfseries] at (\ci+0.5,0.275) {\dayname};
}
\end{tikzpicture}

\vspace{1pt}

% Grid
\noindent\makebox[\linewidth][l]{%
\begin{tikzpicture}
\pgfmathsetmacro{\cellw}{\textwidth/7/1cm}
\def\rowh{2.4}
{{range $wi, $week := $grid.Weeks}}{{range $ci, $cell := $week}}{{if $cell}}%
% Cell row={{$wi}} col={{$ci}}
\pgfmathsetmacro{\xpos}{ {{$ci}}*\cellw}
\pgfmathsetmacro{\ypos}{-{{$wi}}*\rowh}
{{if $cell.Fasting}}\fill[fastingbg] (\xpos,\ypos) rectangle (\xpos+\cellw,\ypos-\rowh);
{{end}}\draw[cellborder] (\xpos,\ypos) rectangle (\xpos+\cellw,\ypos-\rowh);
% Day number
\node[anchor=north west,font=\large\bfseries,inner sep=2pt] at (\xpos+0.08,\ypos-0.05) { {{$cell.DayNum}}};
% Icons
{{if $cell.Icons}}\node[anchor=north east,font=\scriptsize,inner sep=2pt] at (\xpos+\cellw-0.08,\ypos-0.05) { {{range $cell.Icons}}\hspace{2pt}{{.}}\hspace{2pt}{{end}}};
{{end}}% Paksa-Tithi
{{if $cell.TithiSub}}\node[anchor=west,font=\footnotesize,inner sep=2pt] at (\xpos+0.08,\ypos-0.75) { {{$cell.PaksaLabel}}\,\textperiodcentered\,{{$cell.Tithi}}};
\node[anchor=west,font=\scriptsize,text=gray,inner sep=2pt] at (\xpos+0.08,\ypos-1.10) { {{$cell.TithiSub}}};
% Naksatra
\node[anchor=west,font=\scriptsize,text=gray,inner sep=2pt] at (\xpos+0.08,\ypos-1.50) { {{$cell.Naksatra}}};{{else}}\node[anchor=west,font=\footnotesize,inner sep=2pt] at (\xpos+0.08,\ypos-0.75) { {{$cell.PaksaLabel}}\,\textperiodcentered\,{{$cell.Tithi}}};
% Naksatra
\node[anchor=west,font=\scriptsize,text=gray,inner sep=2pt] at (\xpos+0.08,\ypos-1.20) { {{$cell.Naksatra}}};{{end}}
% Footnote refs
{{if $cell.FootnoteRefs}}\node[anchor=south west,font=\scriptsize,inner sep=2pt] at (\xpos+0.08,\ypos-\rowh+0.05) {\textsuperscript{ {{range $cell.FootnoteRefs}}{{.}} {{end}}}};
{{end}}{{else}}%
% Empty cell row={{$wi}} col={{$ci}}
\pgfmathsetmacro{\xpos}{ {{$ci}}*\cellw}
\pgfmathsetmacro{\ypos}{-{{$wi}}*\rowh}
\fill[emptycell] (\xpos,\ypos) rectangle (\xpos+\cellw,\ypos-\rowh);
\draw[cellborder,dashed] (\xpos,\ypos) rectangle (\xpos+\cellw,\ypos-\rowh);
{{end}}{{end}}{{end}}
\end{tikzpicture}}% end \makebox

